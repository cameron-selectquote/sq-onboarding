# Copy to .env and fill in. .env is gitignored; this template is committed.
#
# Onboarding Genie (Strands Agents SDK, Amazon Bedrock provider).
# Set a Bedrock API key to run the live agent at /specialist/genie. Without it,
# the Genie falls back to a built-in deterministic planner (so the app still
# runs offline). The chat shows which engine is active.

# Quickest for local dev: a Bedrock API key.
AWS_BEARER_TOKEN_BEDROCK=

# Alternatively, use standard AWS credentials / profile with Bedrock + Claude
# access instead of a bearer token:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=

# Optional overrides.
# GENIE_MODEL_ID=global.anthropic.claude-sonnet-4-6
# AWS_REGION=us-east-1

# Set to 1 to turn on Strands SDK debug logging (agent loop, tool calls, model
# traffic) in the server console. Off by default.
# GENIE_DEBUG=1
